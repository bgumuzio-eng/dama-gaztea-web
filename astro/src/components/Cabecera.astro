---
import Logo from './Logo.astro';

// En la maqueta, las secciones que aún no tienen página apuntan a su bloque de la portada.
const menu = [
  { texto: 'Academia', href: '/#academia' },
  { texto: 'Centros y horarios', href: '/#centros' },
  { texto: 'Club y torneos', href: '/#torneos' },
  { texto: 'Noticias', href: '/#noticias' },
  { texto: 'Aprende', href: '/aprende/problemas/' },
  { texto: 'Contacto', href: '/#contacto' },
];
const ruta = Astro.url.pathname;

const tipografias = [
  { id: '1', nombre: 'Clásica', fuentes: 'Fraunces + Inter', familia: "'Fraunces Variable'" },
  { id: '2', nombre: 'Elegante', fuentes: 'Playfair Display + Inter', familia: "'Playfair Display Variable'" },
  { id: '3', nombre: 'Cercana', fuentes: 'DM Serif Display + DM Sans', familia: "'DM Serif Display'" },
];
---

<div class="maqueta" role="region" aria-label="Opciones de la maqueta">
  <div class="contenedor maqueta__fila">
    <p class="maqueta__aviso"><strong>Maqueta para el club.</strong> Contenido y fotos de ejemplo.</p>
    <div class="maqueta__tipos" role="group" aria-label="Elige la tipografía">
      <span class="maqueta__etiqueta">Tipografía:</span>
      {
        tipografias.map((t) => (
          <button type="button" class="maqueta__tipo" data-tipo={t.id} title={t.fuentes} aria-pressed="false">
            <span class="maqueta__muestra" style={`font-family:${t.familia}, serif`}>Aa</span>
            <span>
              {t.id}. {t.nombre}
            </span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <Logo />
    <button type="button" class="cabecera__menu-boton" aria-expanded="false" aria-controls="menu-principal">
      <span class="visualmente-oculto">Abrir menú</span>
      <span class="hamburguesa" aria-hidden="true"></span>
    </button>
    <nav id="menu-principal" class="cabecera__nav" aria-label="Principal">
      <ul>
        {
          menu.map((m) => (
            <li>
              <a href={m.href} aria-current={ruta.startsWith(m.href) && m.href !== '/' && !m.href.startsWith('/#') ? 'page' : undefined}>
                {m.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/#contacto" class="boton boton--pequeno cabecera__cta">Pide información</a>
    </nav>
  </div>
</header>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('.maqueta__tipo');
  const marcar = () => {
    const actual = document.documentElement.dataset.tipo ?? '1';
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tipo === actual)));
  };
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.tipo!;
      if (t === '1') delete document.documentElement.dataset.tipo;
      else document.documentElement.dataset.tipo = t;
      try {
        localStorage.setItem('dg-tipo', t);
      } catch {}
      marcar();
    }),
  );
  marcar();

  const menuBoton = document.querySelector<HTMLButtonElement>('.cabecera__menu-boton')!;
  const nav = document.getElementById('menu-principal')!;
  menuBoton.addEventListener('click', () => {
    const abierto = menuBoton.getAttribute('aria-expanded') === 'true';
    menuBoton.setAttribute('aria-expanded', String(!abierto));
    nav.classList.toggle('abierto', !abierto);
  });
  nav.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menuBoton.setAttribute('aria-expanded', 'false');
      nav.classList.remove('abierto');
    }),
  );
</script>

<style>
  .maqueta {
    background: #fff8e1;
    border-bottom: 1px solid #ecdca6;
    font-size: 13px;
    color: #5c4a10;
  }
  .maqueta__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 16px;
    padding-block: 6px;
  }
  .maqueta__aviso {
    margin: 0;
  }
  .maqueta__tipos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .maqueta__etiqueta {
    font-weight: 600;
  }
  .maqueta__tipo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 2px 10px 2px 4px;
    border: 1px solid #ddc879;
    border-radius: 999px;
    background: var(--color-white);
    color: #5c4a10;
    font: 500 13px/1 var(--font-texto);
    cursor: pointer;
  }
  .maqueta__tipo[aria-pressed='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }
  .maqueta__muestra {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgb(212 175 55 / 0.25);
    font-size: 15px;
    font-weight: 600;
  }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-primary);
    border-bottom: 3px solid var(--color-gold);
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }
  .cabecera__menu-boton {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hamburguesa,
  .hamburguesa::before,
  .hamburguesa::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition: transform 0.2s;
  }
  .hamburguesa {
    position: relative;
  }
  .hamburguesa::before,
  .hamburguesa::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburguesa::before {
    top: -7px;
  }
  .hamburguesa::after {
    top: 7px;
  }
  [aria-expanded='true'] .hamburguesa {
    background: transparent;
  }
  [aria-expanded='true'] .hamburguesa::before {
    transform: translateY(7px) rotate(45deg);
  }
  [aria-expanded='true'] .hamburguesa::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .cabecera__nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-primary);
    border-bottom: 3px solid var(--color-gold);
    padding: 8px var(--gutter) 24px;
  }
  .cabecera__nav.abierto {
    display: block;
  }
  .cabecera__nav ul {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }
  .cabecera__nav li a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    color: var(--color-white);
    text-decoration: none;
    font-weight: 500;
  }
  .cabecera__nav a[aria-current='page'] {
    color: var(--color-gold);
  }
  .cabecera__cta {
    width: 100%;
    border-color: var(--color-gold);
  }

  @media (min-width: 1080px) {
    .cabecera__menu-boton {
      display: none;
    }
    .cabecera__nav {
      display: flex;
      position: static;
      align-items: center;
      gap: 20px;
      padding: 0;
      border: 0;
      background: none;
    }
    .cabecera__nav ul {
      display: flex;
      gap: 4px;
      margin: 0;
    }
    .cabecera__nav li a {
      padding: 8px 10px;
      border: 0;
      border-radius: 6px;
      font-size: 0.95rem;
    }
    .cabecera__nav li a:hover {
      background: rgb(255 255 255 / 0.08);
    }
    .cabecera__nav a[aria-current='page'] {
      box-shadow: inset 0 -2px 0 var(--color-gold);
      border-radius: 0;
    }
    .cabecera__cta {
      width: auto;
    }
  }
</style>
