---
import { ruta } from '../lib/rutas';
import Logo from './Logo.astro';

// En la maqueta, las secciones que aún no tienen página apuntan a su bloque de la portada.
const menu = [
  { texto: 'Academia', href: '/#clases' },
  { texto: 'Centros y horarios', href: '/#centros' },
  { texto: 'Club y torneos', href: '/#torneos' },
  { texto: 'Noticias', href: '/#noticias' },
  { texto: 'Aprende', href: '/aprende/problemas/' },
  { texto: 'Contacto', href: '/#contacto' },
];
const actual = Astro.url.pathname;

const tipografias = [
  { id: '1', nombre: 'Clásica', fuentes: 'Fraunces + Inter', familia: "'Fraunces Variable'" },
  { id: '2', nombre: 'Elegante', fuentes: 'Playfair Display + Inter', familia: "'Playfair Display Variable'" },
  { id: '3', nombre: 'Cercana', fuentes: 'DM Serif Display + DM Sans', familia: "'DM Serif Display'" },
];
---

<div class="maqueta" role="region" aria-label="Opciones de la maqueta">
  <div class="contenedor maqueta__fila">
    <p class="maqueta__aviso"><strong>Maqueta en revisión.</strong> Fotos y textos provisionales.</p>
    <div class="maqueta__tipos" role="group" aria-label="Elige la tipografía">
      <span class="maqueta__etiqueta">Tipografía</span>
      {
        tipografias.map((t) => (
          <button type="button" class="maqueta__tipo" data-tipo={t.id} title={t.fuentes} aria-pressed="false">
            <span class="maqueta__muestra" style={`font-family:${t.familia}, serif`}>
              Aa
            </span>
            <span class="maqueta__nombre">{t.nombre}</span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <Logo />
    <button type="button" class="cabecera__menu-boton" aria-expanded="false" aria-controls="menu-principal">
      <span class="visualmente-oculto">Abrir menú</span>
      <span class="hamburguesa" aria-hidden="true"></span>
    </button>
    <nav id="menu-principal" class="cabecera__nav" aria-label="Principal">
      <ul>
        {
          menu.map((m) => (
            <li>
              <a href={ruta(m.href)} aria-current={!m.href.startsWith('/#') && actual.startsWith(ruta(m.href)) ? 'page' : undefined}>
                {m.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={ruta('/#contacto')} class="boton boton--pequeno cabecera__cta">Pide información</a>
    </nav>
  </div>
</header>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('.maqueta__tipo');
  const marcar = () => {
    const actual = document.documentElement.dataset.tipo ?? '1';
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tipo === actual)));
  };
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.tipo!;
      if (t === '1') delete document.documentElement.dataset.tipo;
      else document.documentElement.dataset.tipo = t;
      try {
        localStorage.setItem('dg-tipo', t);
      } catch {}
      marcar();
    }),
  );
  marcar();

  const menuBoton = document.querySelector<HTMLButtonElement>('.cabecera__menu-boton')!;
  const nav = document.getElementById('menu-principal')!;
  const alternar = (abrir: boolean) => {
    menuBoton.setAttribute('aria-expanded', String(abrir));
    nav.classList.toggle('abierto', abrir);
  };
  menuBoton.addEventListener('click', () => alternar(menuBoton.getAttribute('aria-expanded') !== 'true'));
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => alternar(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && alternar(false));

  // Al bajar, la cabecera se compacta a 56 px
  const cabecera = document.querySelector<HTMLElement>('.cabecera')!;
  let compacta = false;
  const revisar = () => {
    const debe = window.scrollY > 80;
    if (debe !== compacta) cabecera.classList.toggle('cabecera--compacta', (compacta = debe));
  };
  window.addEventListener('scroll', revisar, { passive: true });
  revisar();
</script>

<style>
  .maqueta {
    background: var(--color-crema);
    border-bottom: 1px solid var(--color-borde);
    font-size: 12px;
    color: var(--color-text-soft);
  }
  .maqueta__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    padding-block: 5px;
  }
  .maqueta__aviso {
    margin: 0;
  }
  .maqueta__aviso strong {
    color: var(--color-primary);
  }
  .maqueta__tipos {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .maqueta__etiqueta {
    margin-right: 4px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11px;
  }
  .maqueta__tipo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 2px 10px 2px 3px;
    border: 1px solid var(--color-borde);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-text);
    font: 500 12px/1 var(--font-texto);
    cursor: pointer;
    transition: border-color var(--transicion);
  }
  .maqueta__tipo:hover {
    border-color: var(--color-gold);
  }
  .maqueta__tipo[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
  }
  .maqueta__muestra {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-gold);
    font-size: 13px;
    font-weight: 600;
  }
  @media (max-width: 479px) {
    .maqueta__nombre {
      display: none;
    }
    .maqueta__tipo {
      padding-right: 3px;
    }
  }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-primary);
    border-bottom: 1px solid rgb(212 175 55 / 0.45);
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
    transition: min-height var(--transicion);
  }
  .cabecera--compacta {
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
  }
  .cabecera--compacta .cabecera__fila {
    min-height: 56px;
  }
  .cabecera :global(.logo__monograma),
  .cabecera :global(.logo__nombre),
  .cabecera :global(.logo__sub) {
    transition: all var(--transicion);
  }
  .cabecera--compacta :global(.logo__monograma) {
    width: 36px;
    height: 36px;
    font-size: 15px;
  }
  .cabecera--compacta :global(.logo__nombre) {
    font-size: 13px;
  }
  .cabecera--compacta :global(.logo__sub) {
    margin-top: 3px;
    font-size: 10px;
  }
  .cabecera__menu-boton {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hamburguesa,
  .hamburguesa::before,
  .hamburguesa::after {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-white);
    transition: transform var(--transicion), background var(--transicion);
  }
  .hamburguesa {
    position: relative;
  }
  .hamburguesa::before,
  .hamburguesa::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburguesa::before {
    top: -7px;
  }
  .hamburguesa::after {
    top: 7px;
  }
  [aria-expanded='true'] .hamburguesa {
    background: transparent;
  }
  [aria-expanded='true'] .hamburguesa::before {
    transform: translateY(7px) rotate(45deg);
  }
  [aria-expanded='true'] .hamburguesa::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .cabecera__nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    background: var(--color-primary);
    padding: 8px var(--gutter) 24px;
    border-bottom: 1px solid rgb(212 175 55 / 0.45);
  }
  .cabecera__nav.abierto {
    display: block;
  }
  .cabecera__nav ul {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
  }
  .cabecera__nav li a {
    display: block;
    padding: 15px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-white);
    text-decoration: none;
    font-family: var(--font-titulo);
    font-size: 1.35rem;
    letter-spacing: var(--titulo-tracking);
  }
  .cabecera__nav a[aria-current='page'] {
    color: var(--color-gold);
  }
  .cabecera__cta {
    width: 100%;
  }

  @media (min-width: 1100px) {
    .cabecera__menu-boton {
      display: none;
    }
    .cabecera__nav {
      display: flex;
      position: static;
      align-items: center;
      gap: 24px;
      padding: 0;
      border: 0;
      background: none;
      overflow: visible;
      max-height: none;
    }
    .cabecera__nav ul {
      display: flex;
      gap: 26px;
      margin: 0;
    }
    .cabecera__nav li a {
      position: relative;
      padding: 8px 0;
      border: 0;
      font-family: var(--font-texto);
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0;
      color: var(--color-sobre-verde);
    }
    .cabecera__nav li a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 2px;
      height: 1px;
      background: var(--color-gold);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--transicion);
    }
    .cabecera__nav li a:hover {
      color: var(--color-white);
    }
    .cabecera__nav li a:hover::after,
    .cabecera__nav li a[aria-current='page']::after {
      transform: scaleX(1);
    }
    .cabecera__nav a[aria-current='page'] {
      color: var(--color-white);
    }
    .cabecera__cta {
      width: auto;
    }
  }
</style>
