---
// Cabecera de página interior: foto a sangre con degradado verde bosque desde abajo y titular encima.
import Foto from './Foto.astro';
interface Props {
  imagen: { src?: string; alt: string };
  antetitulo?: string;
  titulo: string;
  migas: { texto: string; href?: string }[];
  posicion?: string;
}
const { imagen, antetitulo, titulo, migas, posicion = 'center' } = Astro.props;
---

<header class="cabecera-foto sobre-foto">
  <Foto imagen={imagen} class="cabecera-foto__img" posicion={posicion} prioridad ancho={2000} pie={false} />
  <div class="cabecera-foto__velo" aria-hidden="true"></div>
  <span class="cabecera-foto__provisional">Foto provisional</span>
  <div class="contenedor cabecera-foto__contenido">
    <nav class="migas" aria-label="Migas de pan">
      {
        migas.map((m, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {m.href ? <a href={m.href}>{m.texto}</a> : <span aria-current="page">{m.texto}</span>}
          </>
        ))
      }
    </nav>
    {antetitulo && <p class="antetitulo">{antetitulo}</p>}
    <h1>{titulo}</h1>
    <slot />
  </div>
</header>

<style>
  .cabecera-foto {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 52vh;
    min-height: 52svh;
    color: var(--color-white);
    isolation: isolate;
    overflow: hidden;
  }
  @media (min-width: 960px) {
    .cabecera-foto {
      min-height: 60vh;
      min-height: 60svh;
    }
  }
  .cabecera-foto :global(.cabecera-foto__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .cabecera-foto__velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(20 83 45 / 0.95) 0%, rgb(20 83 45 / 0.7) 40%, rgb(20 83 45 / 0.15) 80%, rgb(20 83 45 / 0.3) 100%),
      linear-gradient(to right, rgb(20 83 45 / 0.45) 0%, transparent 60%);
  }
  .cabecera-foto__provisional {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgb(17 24 39 / 0.5);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.92);
  }
  .cabecera-foto__contenido {
    padding-top: 96px;
    padding-bottom: 48px;
  }
  @media (min-width: 960px) {
    .cabecera-foto__contenido {
      padding-bottom: 64px;
    }
  }
  .migas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 14px;
    color: var(--color-sobre-verde);
  }
  .migas a {
    color: var(--color-sobre-verde);
  }
  .migas a:hover {
    color: var(--color-white);
  }
  .cabecera-foto h1 {
    max-width: 18ch;
    color: var(--color-white);
    margin-bottom: 16px;
  }
  .cabecera-foto :global(.cabecera-foto__sub) {
    margin: 0;
    max-width: 52ch;
    font-size: 1.125rem;
    color: var(--color-sobre-verde);
  }
</style>
