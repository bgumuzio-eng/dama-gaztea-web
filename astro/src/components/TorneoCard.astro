---
import { ruta } from '../lib/rutas';
import { getEntry, type CollectionEntry } from 'astro:content';
import { diaMes, fechaLarga, isoDia, TIPOS_TORNEO } from '../lib/formato';
interface Props {
  torneo: CollectionEntry<'torneos'>;
  avisoPlazo?: boolean;
  tono?: 'claro' | 'oscuro';
}
const { torneo, avisoPlazo = false, tono = 'claro' } = Astro.props;
const { nombre, fecha, horaInicio, lugar, tipo, perteneceAlCircuito, numeroDePrueba, fechaLimite, fechaPorConfirmar } = torneo.data;
const centro = lugar.centro ? await getEntry(lugar.centro) : undefined;
const { dia, mes } = diaMes(fecha);
---

<article class:list={['torneo-card', `torneo-card--${tono}`]}>
  <time class="torneo-card__fecha" datetime={isoDia(fecha)}>
    <span class="torneo-card__dia">{dia}</span>
    <span class="torneo-card__mes">{mes}</span>
  </time>
  <div class="torneo-card__info">
    <p class="etiqueta">{perteneceAlCircuito ? `Circuito · Prueba ${numeroDePrueba}` : TIPOS_TORNEO[tipo]}</p>
    <h3><a href={ruta(`/torneos/${torneo.id}/`)}>{nombre}</a></h3>
    <p class="torneo-card__lugar">
      {fechaPorConfirmar && <span class="confirmar">Fecha (confirmar) · </span>}
      {horaInicio} h · {centro ? `${centro.data.nombre}, ${centro.data.localidad}` : lugar.texto}
    </p>
    {
      avisoPlazo && fechaLimite && !fechaPorConfirmar && (
        <p class="etiqueta etiqueta--alerta">Inscripción hasta el {fechaLarga(fechaLimite).replace(/ de \d{4}$/, '')}</p>
      )
    }
  </div>
</article>

<style>
  .torneo-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    align-items: start;
    padding: 20px 0;
    border-top: 1px solid var(--color-borde);
  }
  .torneo-card--oscuro {
    border-top-color: rgb(212 175 55 / 0.35);
  }
  .torneo-card__fecha {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 64px;
    padding-top: 2px;
    line-height: 1;
  }
  .torneo-card__dia {
    font-family: var(--font-titulo);
    font-weight: var(--titulo-peso);
    font-size: 2.6rem;
    letter-spacing: -0.02em;
    color: var(--color-gold);
  }
  .torneo-card__mes {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-soft);
  }
  .torneo-card--oscuro .torneo-card__mes,
  .torneo-card--oscuro .torneo-card__lugar {
    color: var(--color-sobre-verde);
  }
  .etiqueta {
    margin: 0 0 6px;
  }
  .torneo-card--oscuro .etiqueta:not(.etiqueta--alerta) {
    color: var(--color-gold);
  }
  h3 {
    font-size: 1.4rem;
    margin-bottom: 6px;
  }
  h3 a {
    color: var(--color-primary);
    text-decoration: none;
  }
  .torneo-card--oscuro h3 a {
    color: var(--color-white);
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 1px;
  }
  .torneo-card__lugar {
    margin: 0 0 10px;
    font-size: 15px;
    color: var(--color-text-soft);
  }
  .torneo-card--oscuro .confirmar {
    color: #ffb4a8;
  }
</style>
