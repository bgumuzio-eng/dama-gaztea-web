---
// Tarjeta de centro: foto 3:2, localidad en dorado, nombre y una línea por grupo con día y hora.
import type { CollectionEntry } from 'astro:content';
import Foto from './Foto.astro';
interface Props {
  centro: CollectionEntry<'centros'>;
}
const { centro } = Astro.props;
const { nombre, localidad, grupos, fotos } = centro.data;
---

<article class="centro-card">
  <Foto imagen={fotos[0] ?? { alt: nombre }} proporcion="3 / 2" ancho={800} class="centro-card__foto" />
  <p class="etiqueta">{localidad}</p>
  <h3><a href={`/centros/${centro.id}/`}>{nombre}</a></h3>
  <ul>
    {
      grupos.map((g) => (
        <li>
          <span>{g.diaSemana}</span>
          <span>
            {g.horaInicio} a {g.horaFin}
          </span>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .centro-card {
    position: relative;
    height: 100%;
    padding-bottom: 8px;
    border-radius: var(--radio-foto);
    transition: box-shadow var(--transicion), transform var(--transicion), background var(--transicion);
  }
  .centro-card:hover {
    background: var(--color-white);
    box-shadow: var(--sombra-alta);
    transform: translateY(-2px);
  }
  .centro-card :global(.centro-card__foto) {
    border-radius: var(--radio-foto);
    margin-bottom: 18px;
  }
  .centro-card > :not(:first-child) {
    margin-inline: 4px;
    transition: margin var(--transicion);
  }
  .centro-card:hover > :not(:first-child) {
    margin-inline: 16px;
  }
  .etiqueta {
    margin-top: 0;
    margin-bottom: 6px;
  }
  h3 {
    font-size: 22px;
    margin-bottom: 10px;
  }
  h3 a {
    color: var(--color-primary);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radio-foto);
  }
  ul {
    list-style: none;
    padding: 0;
    margin-bottom: 8px;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  li span:first-child {
    color: var(--color-text-soft);
  }
</style>
