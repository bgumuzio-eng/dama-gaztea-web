---
import type { CollectionEntry } from 'astro:content';
import { TIPOS_CENTRO } from '../lib/formato';
interface Props {
  centro: CollectionEntry<'centros'>;
}
const { centro } = Astro.props;
const { nombre, localidad, tipo, grupos } = centro.data;
const dias = [...new Set(grupos.map((g) => g.diaSemana))].join(' · ');
---

<article class="centro-card">
  <p class="centro-card__localidad">{localidad}</p>
  <h3><a href={`/centros/${centro.id}/`}>{nombre}</a></h3>
  <p class="pequeno texto-suave">{TIPOS_CENTRO[tipo]} · {grupos.length} grupos</p>
  <p class="pequeno">{dias}</p>
</article>

<style>
  .centro-card {
    position: relative;
    padding: 18px 20px;
    background: var(--color-white);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    border-top: 3px solid var(--color-accent);
    transition: box-shadow 0.15s;
  }
  .centro-card:hover {
    box-shadow: var(--sombra-alta);
  }
  .centro-card__localidad {
    margin: 0 0 4px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  h3 {
    font-size: 1.2rem;
    margin-bottom: 6px;
  }
  h3 a {
    color: var(--color-primary);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  p {
    margin: 0 0 4px;
  }
</style>
