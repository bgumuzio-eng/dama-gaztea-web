---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const url = Astro.url.href;
const texto = `${titulo} ${url}`;
---

<div class="compartir">
  <span class="compartir__titulo">Compartir</span>
  <a class="compartir__boton compartir__boton--whatsapp" href={`https://wa.me/?text=${encodeURIComponent(texto)}`} target="_blank" rel="noopener">WhatsApp</a>
  <a class="compartir__boton" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Facebook</a>
  <button type="button" class="compartir__boton" data-copiar>Copiar enlace</button>
  <button type="button" class="compartir__boton" data-compartir={titulo} hidden>Instagram y más</button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        b.textContent = 'Enlace copiado';
      } catch {
        b.textContent = 'No se pudo copiar';
      }
    }),
  );
  // Instagram no tiene enlace para compartir desde web: se usa el menú nativo del móvil.
  document.querySelectorAll<HTMLButtonElement>('[data-compartir]').forEach((b) => {
    if (!navigator.share) return;
    b.hidden = false;
    b.addEventListener('click', () => navigator.share({ title: b.dataset.compartir, url: location.href }).catch(() => {}));
  });
</script>

<style>
  .compartir {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .compartir__titulo {
    margin-right: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-texto);
  }
  .compartir__boton {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    background: var(--color-white);
    color: var(--color-primary);
    font: 600 14px/1 var(--font-texto);
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--transicion), background var(--transicion);
  }
  .compartir__boton:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .compartir__boton--whatsapp {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-white);
  }
  .compartir__boton--whatsapp:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }
</style>
