---
// En la maqueta no envía nada. En la web final enviará al Worker de Cloudflare (Turnstile, Resend, Google Sheets).
import { getCollection } from 'astro:content';
const localidades = [...new Set((await getCollection('centros', ({ data }) => data.activo)).map((c) => c.data.localidad))];
---

<form class="formulario" data-formulario-maqueta novalidate>
  <div class="formulario__fila">
    <label>Nombre<input name="nombre" autocomplete="name" required /></label>
    <label>Teléfono<input name="telefono" type="tel" autocomplete="tel" /></label>
  </div>
  <label>Correo electrónico<input name="email" type="email" autocomplete="email" required /></label>
  <label
    >Localidad de interés
    <select name="localidad">
      <option value="">Elige una opción</option>
      {localidades.map((l) => <option>{l}</option>)}
      <option>Otra</option>
    </select>
  </label>
  <label>Mensaje<textarea name="mensaje" rows="4" placeholder="Edad del alumno, nivel, dudas..."></textarea></label>
  <label class="formulario__casilla">
    <input type="checkbox" name="privacidad" required />
    <span>He leído y acepto la <a href="#">política de privacidad</a>.</span>
  </label>
  <button type="submit" class="boton">Enviar</button>
  <p class="formulario__aviso pequeno" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-formulario-maqueta]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      f.querySelector('.formulario__aviso')!.textContent =
        'Maqueta: en la web real esta solicitud llegará por correo al profesor, quedará guardada en una hoja privada y la familia recibirá una confirmación.';
    }),
  );
</script>

<style>
  .formulario {
    display: grid;
    gap: 14px;
  }
  .formulario__fila {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
  }
  input,
  select,
  textarea {
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    background: var(--color-white);
    font: 400 16px/1.4 var(--font-texto);
    color: var(--color-text);
  }
  textarea {
    resize: vertical;
  }
  .formulario__casilla {
    flex-direction: row;
    align-items: start;
    gap: 10px;
    font-weight: 400;
  }
  .formulario__casilla input {
    min-height: 0;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    accent-color: var(--color-accent);
  }
  .formulario .boton {
    justify-self: start;
  }
  .formulario__aviso {
    margin: 0;
    color: var(--color-primary);
  }
</style>
