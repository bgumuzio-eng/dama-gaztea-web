---
// Entrenador de problemas: el visitante mueve y se valida cada jugada contra solucionJugadas.
// Toda la lógica está en src/scripts/problemas.ts y funciona sin servidor.
import type { CollectionEntry } from 'astro:content';
import { NIVELES } from '../lib/formato';
import { TEMAS_PROBLEMA } from '../content.config';
import '../styles/tablero.css';

interface Props {
  problemas: CollectionEntry<'problemas'>[];
  inicial?: string;
}
const { problemas, inicial } = Astro.props;

const datos = problemas.map((p) => ({
  id: p.id,
  titulo: p.data.titulo,
  posicionFEN: p.data.posicionFEN,
  enunciado: p.data.enunciado,
  solucionJugadas: p.data.solucionJugadas,
  solucion: p.data.solucion,
  nivel: p.data.nivel,
  tema: p.data.tema,
  origen: p.data.origen,
  idLichess: p.data.idLichess,
  puntuacionLichess: p.data.puntuacionLichess,
}));
const temasUsados = TEMAS_PROBLEMA.filter((t) => problemas.some((p) => p.data.tema.includes(t)));
const nombre = (p: (typeof datos)[number]) => p.titulo || `Problema de Lichess ${p.idLichess}`;
---

<section class="entrenador" data-problemas data-inicial={inicial}>
  <script type="application/json" set:html={JSON.stringify(datos)} />

  <div class="entrenador__tablero">
    <div class="tablero" data-tablero></div>
  </div>

  <!-- En escritorio es una tarjeta lateral; en móvil sus partes se colocan alrededor del tablero -->
  <div class="entrenador__panel">
    <div class="entrenador__filtros">
      <fieldset class="filtro-nivel">
        <legend class="rotulo">Nivel</legend>
        <div class="filtro-nivel__opciones">
          <label><input type="radio" name="nivel" value="todos" checked /> Todos</label>
          {
            Object.entries(NIVELES).map(([valor, texto]) => (
              <label>
                <input type="radio" name="nivel" value={valor} /> {texto}
              </label>
            ))
          }
        </div>
      </fieldset>
      <label class="filtro-tema">
        <span class="rotulo">Tema</span>
        <select name="tema">
          <option value="todos">Todos los temas</option>
          {temasUsados.map((t) => <option value={t}>{t[0].toUpperCase() + t.slice(1)}</option>)}
        </select>
      </label>
    </div>

    <div class="entrenador__cabeza">
      <p class="entrenador__distintivo" data-distintivo></p>
      <h2 class="entrenador__enunciado" data-enunciado>Cargando problema...</h2>
      <p class="entrenador__meta" data-meta></p>
    </div>

    <div class="entrenador__acciones">
      <p class="entrenador__mensaje" data-mensaje role="status" aria-live="polite"></p>
      <div class="entrenador__botones">
        <button type="button" class="boton boton--secundario boton--pequeno" data-accion="pista">Pista</button>
        <button type="button" class="boton boton--secundario boton--pequeno" data-accion="solucion">Ver solución</button>
        <button type="button" class="boton boton--secundario boton--pequeno" data-accion="reiniciar">Reiniciar</button>
      </div>
      <button type="button" class="boton entrenador__siguiente" data-accion="siguiente">Siguiente problema</button>
      <form class="entrenador__jugada" data-form-jugada>
        <label for="jugada-texto">O escribe la jugada</label>
        <div>
          <input id="jugada-texto" name="jugada" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Ejemplo: Cf3, Txd8, O-O" />
          <button type="submit" class="boton boton--secundario boton--pequeno">Jugar</button>
        </div>
      </form>
      <div class="solucion" data-solucion hidden>
        <p class="rotulo">Solución</p>
        <p class="solucion__jugadas" data-solucion-jugadas></p>
        <p data-solucion-texto></p>
      </div>
      <dl class="marcador">
        <div class="marcador__racha"><dt>Racha</dt><dd data-marcador="racha">0</dd></div>
        <div><dt>Mejor racha</dt><dd data-marcador="mejorRacha">0</dd></div>
        <div><dt>Aciertos</dt><dd data-marcador="aciertos">0</dd></div>
        <div><dt>Resueltos</dt><dd data-marcador="resueltos">0/{datos.length}</dd></div>
      </dl>
      <p class="entrenador__nota">
        Cuenta como acierto si lo resuelves a la primera, sin fallos, pistas ni solución. Tu progreso se guarda solo en este
        navegador. <button type="button" class="enlace-boton" data-accion="borrar">Empezar de cero</button>
      </p>
    </div>
  </div>

  <div class="entrenador__lista">
    <h2 class="titulo-dorado">Todos los problemas</h2>
    <ol class="lista-problemas">
      {
        datos.map((p) => (
          <li data-item={p.id} data-nivel={p.nivel} data-tema={p.tema.join('|')}>
            <button type="button" data-cargar={p.id}>
              <span class={`nivel nivel--${p.nivel}`}>{NIVELES[p.nivel]}</span>
              <span class="lista-problemas__nombre">{nombre(p)}</span>
              <span class="lista-problemas__temas">
                {p.tema.join(', ')}
                {p.origen === 'propio' && <span class="lista-problemas__propio"> · De las clases de Dama Gaztea</span>}
              </span>
              <span class="lista-problemas__estado" data-estado aria-label="" />
            </button>
          </li>
        ))
      }
    </ol>
    <p class="texto-suave" data-sin-resultados hidden>No hay problemas con ese nivel y tema.</p>
  </div>
</section>

<script src="../scripts/problemas.ts"></script>

<style>
  /* Móvil: enunciado, tablero a todo el ancho, controles y filtros debajo.
     Escritorio: tablero a la izquierda y panel lateral en una tarjeta. */
  .entrenador {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'cabeza' 'tablero' 'acciones' 'filtros' 'lista';
  }
  .entrenador__panel {
    display: contents;
  }
  .entrenador__tablero {
    grid-area: tablero;
    padding: 6px;
  }
  .entrenador__cabeza {
    grid-area: cabeza;
  }
  .entrenador__acciones {
    grid-area: acciones;
  }
  .entrenador__filtros {
    grid-area: filtros;
  }
  .entrenador__lista {
    grid-area: lista;
    margin-top: 40px;
  }
  @media (min-width: 960px) {
    .entrenador {
      column-gap: 56px;
      grid-template-columns: minmax(0, 600px) minmax(0, 1fr);
      grid-template-areas: 'tablero panel' 'lista lista';
      align-items: start;
    }
    .entrenador__panel {
      grid-area: panel;
      display: flex;
      flex-direction: column;
      gap: 28px;
      padding: 32px;
      border-radius: var(--radio-foto);
      background: var(--color-white);
      border: 1px solid var(--color-borde);
      border-top: 1px solid var(--color-gold);
    }
    .entrenador__filtros {
      padding-bottom: 24px;
      border-bottom: 1px solid var(--color-borde);
    }
  }

  .entrenador__distintivo {
    min-height: 1.6em;
    margin: 0 0 8px;
  }
  .entrenador__enunciado {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem);
    margin-bottom: 6px;
  }
  .entrenador__meta {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-soft);
  }

  .entrenador__mensaje {
    min-height: 3.2em;
    margin-bottom: 18px;
    padding: 12px 16px;
    border-radius: var(--radio);
    background: var(--color-crema);
    border-left: 2px solid var(--color-gold);
    font-weight: 500;
    color: var(--color-primary);
  }
  @media (min-width: 960px) {
    .entrenador__mensaje {
      background: var(--color-crema);
    }
  }
  .entrenador__mensaje[data-tipo='ok'] {
    border-left-color: var(--color-accent);
  }
  .entrenador__mensaje[data-tipo='error'] {
    border-left-color: var(--color-alert);
    background: #fbeceb;
    color: #8e1c1c;
  }

  .entrenador__botones {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 10px;
  }
  .entrenador__botones .boton {
    padding-inline: 8px;
  }
  .entrenador__siguiente {
    width: 100%;
    margin-bottom: 24px;
  }

  .entrenador__jugada {
    margin-bottom: 24px;
  }
  .entrenador__jugada label {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    font-weight: 600;
  }
  .entrenador__jugada div {
    display: flex;
    gap: 8px;
  }
  .entrenador__jugada input {
    flex: 1;
    min-width: 0;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    background: var(--color-white);
    font: inherit;
  }

  .solucion {
    margin-bottom: 24px;
    padding: 16px;
    border-radius: var(--radio);
    background: var(--color-crema);
  }
  .solucion .rotulo {
    margin-bottom: 6px;
  }
  .solucion__jugadas {
    font-family: var(--font-titulo);
    font-size: 1.25rem;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }
  .solucion p:last-child {
    margin: 0;
  }

  .marcador {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin: 0 0 16px;
    padding-top: 20px;
    border-top: 1px solid var(--color-borde);
  }
  .marcador div {
    text-align: center;
  }
  .marcador dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }
  .marcador dd {
    margin: 2px 0 0;
    font-family: var(--font-titulo);
    font-weight: var(--titulo-peso);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--color-primary);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .marcador__racha dd {
    color: var(--color-gold-texto);
  }
  .entrenador__nota {
    margin: 0;
    font-size: 13px;
    color: var(--color-text-soft);
  }
  .enlace-boton {
    border: 0;
    padding: 0;
    background: none;
    color: var(--color-accent);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .entrenador__filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: end;
  }
  .filtro-nivel {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .filtro-nivel .rotulo,
  .filtro-tema .rotulo {
    display: block;
    margin-bottom: 8px;
  }
  .filtro-nivel__opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filtro-nivel label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 4px 14px;
    border-radius: 999px;
    border: 1px solid var(--color-borde);
    background: var(--color-white);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--transicion);
  }
  .filtro-nivel label:hover {
    border-color: var(--color-gold);
  }
  .filtro-nivel input {
    position: absolute;
    opacity: 0;
  }
  .filtro-nivel label:has(input:checked) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }
  .filtro-nivel label:has(input:focus-visible) {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .filtro-tema select {
    min-height: 36px;
    padding: 4px 10px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    background: var(--color-white);
    font: inherit;
    font-size: 15px;
  }

  .lista-problemas {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .lista-problemas li[hidden] {
    display: none;
  }
  .lista-problemas button {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'nivel nombre estado' 'nivel temas estado';
    column-gap: 14px;
    align-items: center;
    width: 100%;
    padding: 16px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-foto);
    background: var(--color-white);
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: box-shadow var(--transicion), border-color var(--transicion);
  }
  .lista-problemas button:hover {
    box-shadow: var(--sombra-alta);
  }
  .lista-problemas li.actual button {
    border-color: var(--color-gold);
  }
  .lista-problemas .nivel {
    grid-area: nivel;
  }
  .lista-problemas__nombre {
    grid-area: nombre;
    font-family: var(--font-titulo);
    font-weight: var(--titulo-peso);
    font-size: 1.1rem;
    color: var(--color-primary);
  }
  .lista-problemas__temas {
    grid-area: temas;
    font-size: 14px;
    color: var(--color-text-soft);
  }
  .lista-problemas__propio {
    color: var(--color-gold-texto);
  }
  .lista-problemas__estado {
    grid-area: estado;
    font-size: 1.3rem;
    color: var(--color-gold);
  }
  .nivel {
    display: grid;
    place-items: center;
    width: 64px;
    padding: 6px 0;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nivel--facil {
    background: var(--color-crema);
    color: var(--color-primary);
  }
  .nivel--medio {
    background: var(--color-accent);
    color: var(--color-white);
  }
  .nivel--dificil {
    background: var(--color-primary);
    color: var(--color-gold);
  }
</style>
