---
// Menú inferior fijo en móvil (apartado 8): Inicio, Horarios, Torneos, WhatsApp.
import { enlaceWhatsApp } from '../lib/formato';
interface Props {
  mensaje?: string;
}
const { mensaje } = Astro.props;
---

<nav class="menu-movil" aria-label="Accesos rápidos">
  <a href="/">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4z"></path></svg>
    Inicio
  </a>
  <a href="/#centros">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 7.5V12l3 2"></path></svg>
    Horarios
  </a>
  <a href="/#torneos">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v4.5a4 4 0 0 1-8 0zM8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 12.5V16M8.5 20h7l-1-4h-5z"></path></svg>
    Torneos
  </a>
  <a href={enlaceWhatsApp(mensaje)} target="_blank" rel="noopener" class="menu-movil__whatsapp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6z"></path><path d="M9.3 8.8c.2 2.6 2.4 5 5.2 5.6l.9-1.4-1.6-.9-.8.7a4.6 4.6 0 0 1-2.2-2.2l.7-.8-.9-1.6z"></path></svg>
    WhatsApp
  </a>
</nav>

<style>
  .menu-movil {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: calc(var(--alto-menu-movil) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-white);
    border-top: 1px solid var(--color-borde);
    box-shadow: 0 -6px 20px rgb(31 41 55 / 0.06);
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }
  svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .menu-movil__whatsapp {
    color: var(--color-accent);
  }
  @media (min-width: 1100px) {
    .menu-movil {
      display: none;
    }
  }
</style>
