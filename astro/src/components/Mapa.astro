---
// Mapa esquemático de la ría con marcadores dorados sobre crema. No carga nada externo ni cookies.
import type { CollectionEntry } from 'astro:content';
interface Props {
  centros: CollectionEntry<'centros'>[];
  destacado?: string;
}
const { centros, destacado } = Astro.props;

const caja = { oeste: -3.075, este: -2.895, norte: 43.372, sur: 43.242 };
const ancho = 480;
const alto = 360;
const x = (lng: number) => ((lng - caja.oeste) / (caja.este - caja.oeste)) * ancho;
const y = (lat: number) => ((caja.norte - lat) / (caja.norte - caja.sur)) * alto;
const p = (lat: number, lng: number) => `${x(lng).toFixed(1)},${y(lat).toFixed(1)}`;

// Costa y ría del Nervión, trazado aproximado
const mar = `M0,0 L${ancho},0 L${ancho},${y(43.366).toFixed(1)} C${x(-2.97)},${y(43.37)} ${x(-2.995)},${y(43.36)} ${x(-3.005)},${y(43.345)} L${x(-3.025)},${y(43.333)} C${x(-3.045)},${y(43.336)} ${x(-3.065)},${y(43.342)} 0,${y(43.346)} Z`;
const ria = [
  [43.338, -3.02], [43.325, -3.014], [43.313, -3.004], [43.302, -2.99], [43.29, -2.975], [43.28, -2.96],
  [43.269, -2.946], [43.262, -2.93], [43.255, -2.912],
].map(([la, ln]) => p(la, ln)).join(' ');

// Una etiqueta por localidad, junto a su primer centro
const etiquetas = [...new Map(centros.map((c) => [c.data.localidad, c])).values()];
---

<figure class="mapa">
  <svg viewBox={`0 0 ${ancho} ${alto}`} role="img" aria-labelledby="mapa-titulo">
    <title id="mapa-titulo">Mapa esquemático de los centros de Dama Gaztea en la ría de Bilbao</title>
    <rect width={ancho} height={alto} fill="#F7F4EC"></rect>
    <path d={mar} fill="#ECE5D3"></path>
    <polyline points={ria} fill="none" stroke="#ECE5D3" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></polyline>
    <text x="28" y="40" class="mapa__mar">Mar Cantábrico</text>
    <text x={x(-2.985)} y={y(43.297)} class="mapa__ria" transform={`rotate(38 ${x(-2.985)} ${y(43.297)})`}>Ría de Bilbao</text>
    {
      etiquetas.map((c) => {
        const izquierda = c.data.localidad !== 'Bilbao';
        const cx = x(c.data.ubicacion.lng);
        const cy = y(c.data.ubicacion.lat);
        return (
          <text x={izquierda ? cx - 20 : cx + 20} y={cy + 5} text-anchor={izquierda ? 'end' : 'start'} class="mapa__nombre">
            {c.data.localidad}
          </text>
        );
      })
    }
    {
      centros.map((c) => {
        const activo = c.id === destacado;
        return (
          <a href={`/centros/${c.id}/`} class="mapa__punto" aria-label={`${c.data.nombre}, ${c.data.localidad}`}>
            <circle cx={x(c.data.ubicacion.lng)} cy={y(c.data.ubicacion.lat)} r={activo ? 10 : 8} class:list={['mapa__marca', { activo }]} />
          </a>
        );
      })
    }
  </svg>
</figure>

<style>
  .mapa {
    margin: 0;
    border-radius: var(--radio-foto);
    overflow: hidden;
    border: 1px solid var(--color-borde);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .mapa__mar,
  .mapa__ria {
    font: italic 14px 'Fraunces Variable', Georgia, serif;
    fill: #8a7f66;
  }
  .mapa__ria {
    font-size: 12px;
  }
  .mapa__nombre {
    font: 600 15px 'Inter Variable', system-ui, sans-serif;
    letter-spacing: 0.02em;
    fill: #14532d;
  }
  .mapa__marca {
    fill: #d4af37;
    stroke: #ffffff;
    stroke-width: 3;
    transition: r 200ms ease, fill 200ms ease;
  }
  .mapa__marca.activo {
    fill: #14532d;
    stroke: #d4af37;
  }
  .mapa__punto:hover .mapa__marca,
  .mapa__punto:focus-visible .mapa__marca {
    fill: #14532d;
    stroke: #d4af37;
  }
</style>
