---
// Mapa esquemático de la ría con los centros. En la web final puede sustituirse por un mapa real
// (Google Maps o OpenStreetMap) si se quiere zoom; este no carga nada externo ni cookies.
import type { CollectionEntry } from 'astro:content';
interface Props {
  centros: CollectionEntry<'centros'>[];
  destacado?: string;
}
const { centros, destacado } = Astro.props;

const caja = { oeste: -3.08, este: -2.88, norte: 43.385, sur: 43.235 };
const ancho = 400;
const alto = 300;
const x = (lng: number) => ((lng - caja.oeste) / (caja.este - caja.oeste)) * ancho;
const y = (lat: number) => ((caja.norte - lat) / (caja.norte - caja.sur)) * alto;
const punto = (lat: number, lng: number) => `${x(lng).toFixed(1)},${y(lat).toFixed(1)}`;

// Trazado aproximado de la costa y la ría del Nervión
const mar = `M0,0 L${ancho},0 L${ancho},${y(43.372).toFixed(1)} C${x(-2.96)},${y(43.375)} ${x(-2.99)},${y(43.365)} ${x(-3.0)},${y(43.352)} L${x(-3.03)},${y(43.338)} C${x(-3.05)},${y(43.34)} ${x(-3.07)},${y(43.345)} 0,${y(43.35)} Z`;
const ria = [
  [43.345, -3.017], [43.33, -3.012], [43.315, -3.004], [43.302, -2.99], [43.29, -2.975], [43.28, -2.96],
  [43.268, -2.945], [43.262, -2.928], [43.255, -2.915],
].map(([la, ln]) => punto(la, ln)).join(' ');
---

<figure class="mapa">
  <svg viewBox={`0 0 ${ancho} ${alto}`} role="img" aria-labelledby="mapa-titulo">
    <title id="mapa-titulo">Mapa esquemático de los centros de Dama Gaztea en la ría de Bilbao</title>
    <rect width={ancho} height={alto} fill="#F3F8F4"></rect>
    <path d={mar} fill="#cfe3d4"></path>
    <polyline points={ria} fill="none" stroke="#cfe3d4" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"></polyline>
    <text x="24" y="34" class="mapa__mar">Mar Cantábrico</text>
    {
      centros.map((c) => {
        const cx = x(c.data.ubicacion.lng);
        const cy = y(c.data.ubicacion.lat);
        const activo = c.id === destacado;
        const izquierda = c.data.localidad !== 'Bilbao';
        return (
          <a href={`/centros/${c.id}/`} class="mapa__punto">
            <circle cx={cx} cy={cy} r={activo ? 13 : 10} fill={activo ? '#D4AF37' : '#14532D'} stroke="#D4AF37" stroke-width="3" />
            <text x={izquierda ? cx - 18 : cx + 18} y={cy + 5} text-anchor={izquierda ? 'end' : 'start'} class="mapa__nombre">
              {c.data.localidad}
            </text>
          </a>
        );
      })
    }
  </svg>
</figure>

<style>
  .mapa {
    margin: 0;
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
    background: var(--color-surface);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .mapa__mar {
    font: italic 13px var(--font-titulo);
    fill: #2e7d32;
    opacity: 0.7;
  }
  .mapa__nombre {
    font: 600 16px var(--font-texto);
    fill: #14532d;
    paint-order: stroke;
    stroke: #f3f8f4;
    stroke-width: 4px;
  }
  .mapa__punto:hover circle,
  .mapa__punto:focus-visible circle {
    fill: #d4af37;
  }
</style>
