---
import Logo from './Logo.astro';
import ajustes from '../data/ajustes.json';
import { centrosActivos } from '../lib/datos';
import { enlaceWhatsApp } from '../lib/formato';

const centros = await centrosActivos();
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor">
    <p class="pie__cierre">{ajustes.fraseCierre}</p>
    <div class="pie__rejilla">
      <div class="pie__marca">
        <Logo eslogan />
      </div>
      <div>
        <h2 class="pie__titulo">Centros</h2>
        <ul>
          {
            centros.map((c) => (
              <li>
                <a href={`/centros/${c.id}/`}>
                  {c.data.nombre}, {c.data.localidad}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="pie__titulo">Contacto</h2>
        <ul>
          <li><a href={`tel:+34${ajustes.telefono.replace(/\s/g, '')}`}>{ajustes.telefono}</a></li>
          <li><a href={enlaceWhatsApp()}>WhatsApp</a></li>
          <li><a href={`mailto:${ajustes.email}`}>{ajustes.email}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="pie__titulo">Síguenos</h2>
        <ul>
          <li><a href={ajustes.redes.instagram} rel="noopener">Instagram</a></li>
          <li><a href={ajustes.redes.tiktok} rel="noopener">TikTok</a></li>
          <li><a href={ajustes.redes.youtube} rel="noopener">YouTube</a></li>
        </ul>
      </div>
    </div>
    <div class="pie__legal">
      <span>© {anio} {ajustes.nombreAcademia}</span>
      <a href="#">Aviso legal</a>
      <a href="#">Privacidad</a>
      <a href="#">Cookies</a>
      <a href="#">Imagen de menores</a>
      <a href="#">Panel</a>
    </div>
  </div>
</footer>

<style>
  /* Patrón de tablero casi imperceptible: #113F25 sobre #14532D, solo aquí */
  .pie {
    background:
      repeating-conic-gradient(var(--color-primary-oscuro) 0 25%, transparent 0 50%) 0 0 / 64px 64px,
      var(--color-primary);
    color: var(--color-sobre-verde);
    padding-top: var(--separacion);
    padding-bottom: calc(var(--alto-menu-movil) + 16px);
  }
  @media (min-width: 1100px) {
    .pie {
      padding-bottom: 24px;
    }
  }
  .pie__cierre {
    margin: 0 0 var(--separacion);
    text-align: center;
    font-family: var(--font-titulo);
    font-style: italic;
    font-weight: 400;
    font-size: 24px;
    color: var(--color-gold);
  }
  .pie__rejilla {
    display: grid;
    gap: 32px;
    padding-bottom: 48px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  @media (min-width: 960px) {
    .pie__rejilla {
      grid-template-columns: 1.4fr 1.2fr 1fr 0.8fr;
    }
  }
  .pie__titulo {
    font-family: var(--font-texto);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 14px;
  }
  .pie ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pie li {
    margin-bottom: 8px;
    font-size: 15px;
  }
  .pie a {
    color: var(--color-sobre-verde);
    text-decoration: none;
  }
  .pie a:hover {
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
  }
  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 20px;
    border-top: 1px solid rgb(212 175 55 / 0.3);
    font-size: 13px;
    color: rgb(255 255 255 / 0.7);
  }
  .pie__legal a {
    color: rgb(255 255 255 / 0.7);
  }
</style>
