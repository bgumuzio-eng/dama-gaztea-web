---
import { ruta } from '../lib/rutas';
// Logotipo provisional (apartado 9 de la dirección de diseño): monograma DG en círculo dorado.
interface Props {
  eslogan?: boolean;
  tono?: 'claro' | 'oscuro';
}
const { eslogan = false, tono = 'claro' } = Astro.props;
---

<a href={ruta('/')} class:list={['logo', `logo--${tono}`]} aria-label="Dama Gaztea Ajedrez, inicio">
  <span class="logo__monograma" aria-hidden="true">DG</span>
  <span class="logo__texto">
    <span class="logo__nombre">DAMA GAZTEA</span>
    <span class="logo__sub">AJEDREZ</span>
    {eslogan && <span class="logo__eslogan">Aprende jugando. Crece pensando.</span>}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-white);
  }
  .logo--oscuro {
    color: var(--color-primary);
  }
  .logo:hover {
    color: inherit;
  }
  .logo__monograma {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border: 1.5px solid var(--color-gold);
    border-radius: 50%;
    font-family: 'Fraunces Variable', Georgia, serif;
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
    font-optical-sizing: auto;
  }
  .logo__texto {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__nombre {
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.12em;
  }
  .logo__sub {
    margin-top: 5px;
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.32em;
    opacity: 0.85;
  }
  .logo__eslogan {
    margin-top: 12px;
    font-family: var(--font-titulo);
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0;
    opacity: 0.9;
  }
</style>
