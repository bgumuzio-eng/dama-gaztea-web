---
import { ruta } from '../lib/rutas';
// Tarjeta de noticia: foto 3:2, etiqueta dorada, titular Fraunces 22 px, fecha en gris.
// Toda la tarjeta es enlace; sombra solo al pasar el ratón.
import type { CollectionEntry } from 'astro:content';
import Foto from './Foto.astro';
import { fechaLarga, isoDia } from '../lib/formato';
interface Props {
  noticia: CollectionEntry<'noticias'>;
}
const { noticia } = Astro.props;
const { titulo, fecha, categoria, imagenPrincipal } = noticia.data;
---

<article class="noticia-card">
  <Foto imagen={imagenPrincipal} proporcion="3 / 2" ancho={800} class="noticia-card__foto" />
  <div class="noticia-card__cuerpo">
    <p class="etiqueta">{categoria}</p>
    <h3><a href={ruta(`/noticias/${noticia.id}/`)}>{titulo}</a></h3>
    <time datetime={isoDia(fecha)}>{fechaLarga(fecha)}</time>
  </div>
</article>

<style>
  .noticia-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radio-foto);
    background: var(--color-white);
    transition: box-shadow var(--transicion), transform var(--transicion);
  }
  .noticia-card:hover {
    box-shadow: var(--sombra-alta);
    transform: translateY(-2px);
  }
  .noticia-card :global(.noticia-card__foto) {
    border-radius: var(--radio-foto);
  }
  .noticia-card__cuerpo {
    padding: 18px 4px 8px;
    transition: padding var(--transicion);
  }
  .noticia-card:hover .noticia-card__cuerpo {
    padding-inline: 16px;
  }
  .etiqueta {
    margin: 0 0 8px;
  }
  h3 {
    font-size: 22px;
    line-height: 1.2;
    margin-bottom: 10px;
  }
  h3 a {
    color: var(--color-primary);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radio-foto);
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  time {
    font-size: 14px;
    color: var(--color-text-soft);
  }
</style>
