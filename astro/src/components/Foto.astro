---
// Fotografía con pie "foto provisional" mientras sea de Unsplash (src bajo /img/provisionales/).
// Si no hay src se usa una provisional genérica: en la maqueta no queda ningún hueco gris.
interface Props {
  imagen: { src?: string; alt: string };
  proporcion?: string;
  class?: string;
  posicion?: string;
  prioridad?: boolean;
  ancho?: number;
  pie?: boolean;
}
const { imagen, proporcion, class: clase, posicion = 'center', prioridad = false, ancho = 1600, pie = true } = Astro.props;
const src = imagen.src ?? '/img/provisionales/piezas-madera-desenfoque.jpg';
const provisional = src.includes('/img/provisionales/');
const estilo = [proporcion && `aspect-ratio:${proporcion}`, `object-position:${posicion}`].filter(Boolean).join(';');
---

<figure class:list={['foto', clase]}>
  <img
    src={src}
    alt={imagen.alt}
    style={estilo}
    width={ancho}
    height={Math.round(ancho / 1.5)}
    loading={prioridad ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={prioridad ? 'high' : 'auto'}
  />
  {pie && provisional && <figcaption class="foto__provisional">Foto provisional</figcaption>}
</figure>

<style>
  .foto {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .foto__provisional {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgb(17 24 39 / 0.55);
    color: rgb(255 255 255 / 0.92);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    pointer-events: none;
  }
</style>
