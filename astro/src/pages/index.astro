---
import { ruta } from '../lib/rutas';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import IconoPieza from '../components/IconoPieza.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import TorneoCard from '../components/TorneoCard.astro';
import Mapa from '../components/Mapa.astro';
import TableroFEN from '../components/TableroFEN.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import ajustes from '../data/ajustes.json';
import { centrosActivos, noticiasPublicadas, problemaDeLaSemana, torneosProximos } from '../lib/datos';
import { enlaceWhatsApp, fechaLarga } from '../lib/formato';

const noticias = (await noticiasPublicadas()).slice(0, 4);
const torneos = await torneosProximos();
const centros = await centrosActivos();
const problema = await problemaDeLaSemana();

// Datos de damagaztea.com; lo no verificado lleva (confirmar)
const cifras = [
  { valor: '30+', texto: 'años enseñando' },
  { valor: '14', texto: 'centros en Bizkaia' },
  { valor: '9', texto: 'ediciones del Torneo de Reyes Magos' },
];

const confianza = [
  { pieza: 'rey', texto: 'Más de 30 años enseñando' },
  { pieza: 'torre', texto: 'Clases en 14 centros de Bizkaia' },
  { pieza: 'caballo', texto: 'Circuito propio de torneos' },
] as const;

const niveles = [
  {
    titulo: 'Iniciación',
    texto: 'Primeros movimientos: el nombre de cada pieza, las reglas, el jaque y el mate. Para quien empieza de cero.',
    foto: { src: '/img/provisionales/nina-jugando.jpg', alt: 'Alumna de iniciación moviendo una pieza' },
  },
  {
    titulo: 'Nivel medio',
    texto: 'Táctica, estrategia, principios de apertura, finales fundamentales y análisis de partidas.',
    foto: { src: '/img/provisionales/ninos-partida-madera.jpg', alt: 'Dos alumnos jugando una partida en clase' },
  },
  {
    titulo: 'Avanzado y competición',
    texto: 'Para jugadores federados o con muchas ganas de progresar: cálculo, preparación y torneos.',
    foto: { src: '/img/provisionales/joven-concentrado.jpg', alt: 'Jugador concentrado durante un torneo' },
  },
];

const hitos = [
  'Torneo de Reyes Magos: nueve ediciones',
  'Circuito Dama Gaztea, nacido en 2012',
  'Alumnos campeones de Bizkaia',
  'Alumnos campeones de España',
  'Simultáneas con grandes maestros',
  'Campus de verano y de Carnaval',
];
const porConfirmar = new Set(['Alumnos campeones de España', 'Simultáneas con grandes maestros']);
---

<Base>
  <link slot="head" rel="preload" href={ruta('/img/provisionales/hero-ninos-biblioteca.jpg')} as="image" fetchpriority="high" />

  <section class="hero sobre-foto" aria-labelledby="hero-titulo">
    <div class="hero__escena">
    <Foto
      imagen={{ src: '/img/provisionales/hero-ninos-biblioteca.jpg', alt: 'Dos niños jugando una partida en un tablero grande de madera' }}
      class="hero__foto"
      posicion="58% 35%"
      prioridad
      ancho={2400}
      pie={false}
    />
    <div class="hero__velo" aria-hidden="true"></div>
    <span class="hero__provisional">Foto provisional</span>
    <div class="contenedor hero__contenido">
      <div class="hero__texto">
        <p class="antetitulo">Enseñando ajedrez en Bizkaia desde 1994</p>
        <h1 id="hero-titulo">Aprende jugando.<br />Crece pensando.</h1>
        <p class="hero__intro">
          Clases de ajedrez para niños, jóvenes y adultos en Getxo, Sestao y Bilbao, con torneos, campus y un método propio.
        </p>
        <div class="hero__botones">
          <a href="#centros" class="boton">Clases y horarios</a>
          <a href="#torneos" class="boton boton--claro">Próximos torneos</a>
        </div>
      </div>
    </div>
    </div>
    <div class="contenedor hero__franja">
      <dl class="hero__cifras">
        {
          cifras.map((c) => (
            <div>
              <dt class="visualmente-oculto">{c.texto}</dt>
              <dd>
                <span class="cifra">{c.valor}</span>
                <span class="cifra__texto">{c.texto}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="confianza" aria-label="Por qué Dama Gaztea">
    <ul class="contenedor confianza__lista">
      {
        confianza.map((c) => (
          <li>
            <IconoPieza pieza={c.pieza} tamano={30} class="confianza__icono" />
            <span>{c.texto}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="clases" class="seccion">
    <div class="contenedor">
      <div class="seccion__cabecera">
        <div>
          <div class="titulo-seccion">
            <span class="titulo-seccion__num">01</span>
            <h2>Clases para cada edad y nivel</h2>
          </div>
          <p class="seccion__intro">
            Tres niveles, grupos reducidos y un dossier con ejercicios después de cada sesión. Desde Txiki Chess para los de 3 a 5
            años hasta la preparación para torneos.
          </p>
        </div>
        <a href="#centros" class="boton">Ver horarios</a>
      </div>
      <div class="niveles">
        {
          niveles.map((n, i) => (
            <article class="nivel">
              <Foto imagen={n.foto} proporcion="4 / 3" ancho={900} class="nivel__foto" />
              <p class="nivel__num">Nivel {i + 1}</p>
              <h3>{n.titulo}</h3>
              <p class="texto-suave">{n.texto}</p>
            </article>
          ))
        }
      </div>
      <p class="clases__extra texto-suave">
        También hay <a href="#contacto">clases online</a> con entrenador titulado y extraescolares a medida para colegios.
      </p>
    </div>
  </section>

  <section id="centros" class="seccion seccion--crema">
    <div class="contenedor">
      <div class="seccion__cabecera">
        <div>
          <div class="titulo-seccion">
            <span class="titulo-seccion__num">02</span>
            <h2>Clases cerca de casa</h2>
          </div>
          <p class="seccion__intro">Horarios del curso 2026/2027 en nuestros locales. El resto de los 14 centros son extraescolares en colegios.</p>
        </div>
      </div>
      <div class="centros">
        <Mapa centros={centros} />
        <div class="centros__lista">
          {
            centros.map((c) => (
              <article class="centro">
                <p class="rotulo">{c.data.localidad}</p>
                <h3>
                  <a href={ruta(`/centros/${c.id}/`)}>{c.data.nombre}</a>
                </h3>
                <ul>
                  {c.data.grupos.map((g) => (
                    <li>
                      <span>{g.diaSemana}</span>
                      <span>
                        {g.horaInicio} a {g.horaFin}
                      </span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
          <a href={enlaceWhatsApp('Hola, quiero saber si hay plaza en algún grupo de Dama Gaztea.')} class="boton centros__boton" target="_blank" rel="noopener">
            Preguntar por plazas
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="torneos" class="torneos sobre-foto">
    <Foto imagen={{ src: '/img/provisionales/sala-torneo-jugadores.jpg', alt: 'Sala de juego llena de tableros durante un torneo' }} class="torneos__foto" ancho={1600} pie={false} />
    <div class="torneos__velo" aria-hidden="true"></div>
    <span class="hero__provisional torneos__provisional">Foto provisional</span>
    <div class="contenedor torneos__contenido">
      <div>
        <div class="titulo-seccion">
          <span class="titulo-seccion__num">03</span>
          <h2>Competir también se aprende</h2>
        </div>
        <p class="torneos__intro">
          Organizamos torneos escolares, blitz y de Navidad, y acompañamos a nuestros alumnos en las competiciones de Bizkaia y Euskadi.
        </p>
        <ul class="hitos">
          {
            hitos.map((h) => (
              <li>
                {h}
                {porConfirmar.has(h) && <span class="confirmar"> (confirmar)</span>}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="torneos__panel">
        <p class="antetitulo">Próximos torneos</p>
        {torneos.map((t, i) => <TorneoCard torneo={t} avisoPlazo={i === 0} tono="oscuro" />)}
        <a href={ruta(`/torneos/${torneos[0]?.id}/`)} class="boton boton--claro torneos__boton">Ver el torneo</a>
      </div>
    </div>
  </section>

  <section id="noticias" class="seccion">
    <div class="contenedor">
      <div class="seccion__cabecera">
        <div class="titulo-seccion">
          <span class="titulo-seccion__num">04</span>
          <h2>Noticias del club</h2>
        </div>
        <a href="#noticias" class="enlace-flecha">Todas las noticias</a>
      </div>
    </div>
    <div class="carrusel-envoltorio">
      <ul class="contenedor carrusel" aria-label="Últimas noticias">
        {
          noticias.map((n) => (
            <li>
              <NoticiaCard noticia={n} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="profesor" class="seccion seccion--verde">
    <div class="contenedor profesor">
      <Foto
        imagen={{ src: '/img/provisionales/monitor-tablero.jpg', alt: 'Retrato provisional del profesor junto al tablero' }}
        proporcion="4 / 5"
        posicion="50% 30%"
        ancho={1000}
        class="profesor__foto"
        textoPie="Retrato provisional, se sustituirá por el de Álex"
      />
      <div class="profesor__texto">
        <div class="titulo-seccion">
          <span class="titulo-seccion__num">05</span>
          <h2>{ajustes.profesor}</h2>
        </div>
        <p class="profesor__cargo">Monitor y fundador de Dama Gaztea</p>
        <p>
          Monitor nacional de ajedrez desde 1994, jugador de competición y entrenador. Formó parte del Club Ajedrez Sestao que ganó la
          División de Honor de la Liga Vasca y ha sido entrenador y delegado de la Federación Vasca en los Campeonatos de España por
          Edades.
        </p>
        <blockquote class="cita">
          <p>«En nuestras clases, equivocarse no es un problema, sino una oportunidad para aprender.»</p>
        </blockquote>
        <dl class="profesor__cifras">
          <div>
            <dt class="visualmente-oculto">Año de inicio como monitor</dt>
            <dd><span class="cifra">1994</span><span class="cifra__texto">monitor nacional</span></dd>
          </div>
          <div>
            <dt class="visualmente-oculto">Elo FIDE máximo</dt>
            <dd><span class="cifra">2110</span><span class="cifra__texto">Elo FIDE máximo</span></dd>
          </div>
        </dl>
        <a href="#profesor" class="enlace-flecha profesor__enlace">Conoce su trayectoria</a>
      </div>
    </div>
  </section>

  <section id="aprende" class="seccion">
    <div class="contenedor">
      <div class="seccion__cabecera">
        <div class="titulo-seccion">
          <span class="titulo-seccion__num">06</span>
          <h2>Sigue aprendiendo fuera de clase</h2>
        </div>
      </div>
      <div class="aprende">
        {
          problema && (
            <article class="aprende__tarjeta semana">
              <div class="aprende__media semana__tablero">
                <TableroFEN fen={problema.data.posicionFEN} etiqueta={`Posición del problema de la semana: ${problema.data.enunciado}`} />
              </div>
              <div>
                <p class="etiqueta">Problema de la semana</p>
                <h3>{problema.data.enunciado}</h3>
                <p class="texto-suave">
                  Semana del {fechaLarga(problema.data.destacadoSemana!)}. Resuélvelo moviendo las piezas y sigue con más problemas por
                  niveles.
                </p>
                <a href={ruta(`/aprende/problemas/?p=${problema.id}`)} class="boton">
                  Resolver en el tablero
                </a>
              </div>
            </article>
          )
        }
        <article class="aprende__tarjeta campus">
          <Foto
            imagen={{ src: '/img/provisionales/partida-al-aire-libre.jpg', alt: 'Niños jugando al ajedrez al aire libre en verano' }}
            proporcion="1 / 1"
            ancho={900}
            class="aprende__media campus__foto"
          />
          <p class="etiqueta">Campus</p>
          <h3>Campus de verano y de Carnaval</h3>
          <p class="texto-suave">Ajedrez cada mañana combinado con deporte, piscina, juegos y excursiones. Transporte y comida incluidos en verano.</p>
          <a href="#contacto" class="enlace-flecha">Pide información del campus</a>
        </article>
      </div>
    </div>
  </section>

  <section id="contacto" class="seccion seccion--crema">
    <div class="contenedor contacto">
      <div>
        <div class="titulo-seccion">
          <span class="titulo-seccion__num">07</span>
          <h2>Pide información</h2>
        </div>
        <p class="seccion__intro">Cuéntanos la edad y el nivel del alumno y te recomendamos el grupo que mejor encaja.</p>
        <dl class="contacto__datos">
          <div>
            <dt class="rotulo">Teléfono y WhatsApp</dt>
            <dd><a href={`tel:+34${ajustes.telefono.replace(/\s/g, '')}`}>{ajustes.telefono}</a></dd>
          </div>
          <div>
            <dt class="rotulo">Correo</dt>
            <dd><a href={`mailto:${ajustes.email}`}>{ajustes.email}</a></dd>
          </div>
          <div>
            <dt class="rotulo">Lista de difusión</dt>
            <dd>
              <a href={enlaceWhatsApp('Hola, quiero unirme a la lista de difusión de Dama Gaztea.')} target="_blank" rel="noopener">
                Únete por WhatsApp
              </a> y recibe torneos y avisos.
            </dd>
          </div>
        </dl>
      </div>
      <div class="contacto__formulario">
        <FormularioContacto />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: foto a sangre con degradado verde bosque desde abajo */
  /* En móvil las cifras van en una franja verde bajo la foto para no tapar la imagen;
     en escritorio se superponen abajo a la derecha. */
  .hero {
    position: relative;
    color: var(--color-white);
    background: var(--color-primary);
  }
  .hero__escena {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 70vh;
    min-height: 70svh;
    isolation: isolate;
    overflow: hidden;
  }
  @media (min-width: 960px) {
    .hero__escena {
      min-height: 85vh;
      min-height: 85svh;
    }
  }
  @media (min-width: 1200px) {
    .hero__franja {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 64px;
      display: flex;
      justify-content: flex-end;
      pointer-events: none;
    }
  }
  @media (max-width: 1199px) {
    .hero__franja {
      padding-bottom: 32px;
    }
  }
  .hero :global(.hero__foto) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(20 83 45 / 0.92) 0%, rgb(20 83 45 / 0.6) 38%, rgb(20 83 45 / 0.12) 72%, rgb(20 83 45 / 0.25) 100%),
      linear-gradient(to right, rgb(20 83 45 / 0.55) 0%, transparent 55%);
  }
  /* En móvil la etiqueta cae sobre las piezas: franja semitransparente y degradado más alto */
  @media (max-width: 959px) {
    .hero__velo {
      background: linear-gradient(
        to top,
        rgb(20 83 45 / 0.96) 0%,
        rgb(20 83 45 / 0.82) 45%,
        rgb(20 83 45 / 0.35) 75%,
        rgb(20 83 45 / 0.2) 100%
      );
    }
    .hero .antetitulo {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 4px;
      background: rgb(17 63 37 / 0.82);
      line-height: 1.3;
    }
  }
  .hero__provisional {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgb(17 24 39 / 0.5);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.92);
  }
  .hero__contenido {
    padding-top: 96px;
    padding-bottom: 32px;
  }
  @media (min-width: 960px) {
    .hero__contenido {
      padding-bottom: 64px;
    }
  }
  .hero__texto {
    max-width: 640px;
  }
  .hero h1 {
    color: var(--color-white);
    font-size: clamp(36px, 1.4rem + 3.2vw, 56px);
    margin-bottom: 20px;
  }
  .hero__intro {
    font-size: 1.125rem;
    max-width: 44ch;
    color: var(--color-sobre-verde);
    margin-bottom: 32px;
  }
  .hero__botones {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 560px) {
    .hero__botones {
      flex-direction: row;
    }
  }
  .hero__cifras {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 24px 32px;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid rgb(212 175 55 / 0.5);
  }
  @media (min-width: 1200px) {
    .hero__cifras {
      gap: 40px;
      padding-top: 0;
      padding-left: 40px;
      border-top: 0;
      border-left: 1px solid rgb(212 175 55 / 0.5);
    }
  }
  .hero__cifras dd {
    margin: 0;
    max-width: 150px;
  }
  @media (min-width: 1200px) {
    .hero__cifras {
      pointer-events: auto;
    }
  }
  @media (max-width: 559px) {
    .hero__cifras {
      gap: 16px;
    }
    .hero__cifras .cifra {
      font-size: 2.25rem;
    }
    .hero__cifras .cifra__texto {
      font-size: 11px;
      letter-spacing: 0.04em;
    }
  }

  /* Franja de confianza */
  .confianza {
    background: var(--color-crema);
    border-bottom: 1px solid var(--color-borde);
  }
  .confianza__lista {
    display: grid;
    gap: 16px;
    margin: 0 auto;
    padding-block: 28px;
    list-style: none;
  }
  @media (min-width: 720px) {
    .confianza__lista {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  .confianza li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 500;
    color: var(--color-primary);
  }
  .confianza :global(.confianza__icono) {
    flex: none;
    color: var(--color-gold);
  }

  /* 01 Clases */
  .niveles {
    display: grid;
    gap: 40px 28px;
  }
  @media (min-width: 760px) {
    .niveles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .nivel :global(.nivel__foto) {
    border-radius: var(--radio-foto);
    margin-bottom: 20px;
  }
  .nivel__num {
    margin: 0 0 6px;
    font-family: var(--font-titulo);
    font-style: italic;
    color: var(--color-gold-texto);
  }
  .nivel p:last-child {
    margin: 0;
  }
  .clases__extra {
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-borde);
  }

  /* 02 Centros */
  .centros {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .centros {
      grid-template-columns: 1.15fr 1fr;
      gap: 64px;
    }
  }
  .centros__lista {
    display: grid;
  }
  .centro {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-borde);
  }
  .centro:first-child {
    padding-top: 0;
  }
  .centro .rotulo {
    margin-bottom: 4px;
  }
  .centro h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .centro h3 a {
    color: var(--color-primary);
    text-decoration: none;
  }
  .centro h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 1px;
  }
  .centro ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .centro li {
    display: flex;
    justify-content: space-between;
    max-width: 320px;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .centro li span:first-child {
    color: var(--color-text-soft);
  }
  .centros__boton {
    justify-self: start;
    margin-top: 28px;
  }

  /* 03 Torneos: foto a sangre con texto */
  .torneos {
    position: relative;
    isolation: isolate;
    padding-block: var(--separacion);
    color: var(--color-sobre-verde);
    overflow: hidden;
  }
  .torneos :global(.torneos__foto) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .torneos__velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, rgb(20 83 45 / 0.94) 0%, rgb(20 83 45 / 0.82) 45%, rgb(20 83 45 / 0.6) 100%);
  }
  .torneos__provisional {
    top: auto;
    bottom: 12px;
  }
  .torneos h2 {
    color: var(--color-white);
  }
  .torneos__contenido {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 960px) {
    .torneos__contenido {
      grid-template-columns: 1.1fr 1fr;
      gap: 80px;
      align-items: center;
    }
  }
  .torneos__intro {
    max-width: 50ch;
    margin: 24px 0 28px;
    font-size: 1.1rem;
  }
  .hitos {
    display: grid;
    gap: 12px 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
