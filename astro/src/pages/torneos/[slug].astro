---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartel from '../../components/Cartel.astro';
import IconoPieza from '../../components/IconoPieza.astro';
import { fechaLarga, diaSemana, isoDia, TIPOS_TORNEO } from '../../lib/formato';

export async function getStaticPaths() {
  const torneos = await getCollection('torneos');
  return torneos.map((torneo) => ({ params: { slug: torneo.id }, props: { torneo } }));
}

interface Props {
  torneo: CollectionEntry<'torneos'>;
}
const { torneo } = Astro.props;
const {
  nombre, fecha, horaInicio, lugar, tipo, perteneceAlCircuito, numeroDePrueba, categorias, bases, inscripcion, fechaLimite,
  fechaPorConfirmar, estado, cronica,
} = torneo.data;
const { Content } = await render(torneo);
const centro = lugar.centro ? await getEntry(lugar.centro) : undefined;
const sitio = centro ? `${centro.data.nombre}, ${centro.data.localidad}` : (lugar.texto ?? '');
const direccion = centro?.data.direccion ?? lugar.texto ?? '';
const plazoAbierto = estado === 'proximo' && (!fechaLimite || fechaLimite.getTime() >= Date.now() - 864e5);
const tipoTexto = perteneceAlCircuito ? `Circuito Dama Gaztea · Prueba ${numeroDePrueba}` : TIPOS_TORNEO[tipo];

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: nombre,
  startDate: `${isoDia(fecha)}T${horaInicio}:00+01:00`,
  eventStatus: estado === 'cancelado' ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: sitio, address: direccion },
  organizer: { '@type': 'Organization', name: 'Dama Gaztea Ajedrez' },
};

const despues = [
  { pieza: 'dama', titulo: 'Crónica', texto: 'El resumen de la jornada con lo más destacado de cada categoría.' },
  { pieza: 'torre', titulo: 'Clasificación', texto: 'La tabla final por categorías y el enlace a Chess-Results.' },
  { pieza: 'peon', titulo: 'Fotos', texto: 'La galería del torneo y de la entrega de premios.' },
  { pieza: 'caballo', titulo: 'Partidas', texto: 'Las mejores partidas en un tablero que se puede reproducir.' },
] as const;
---

<Base titulo={nombre} descripcion={`${nombre}. ${fechaLarga(fecha)} en ${sitio}.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

  <header class="contenedor torneo__cabecera">
    <nav class="migas" aria-label="Migas de pan">
      <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/#torneos">Club y torneos</a>
    </nav>
    <p class="etiqueta">{tipoTexto} · {estado === 'proximo' ? 'Próximo' : estado === 'celebrado' ? 'Celebrado' : 'Cancelado'}</p>
    <h1>{nombre}</h1>
  </header>

  <div class="contenedor torneo__rejilla">
    <div class="torneo__cartel">
      <Cartel nombre={nombre} fecha={fecha} hora={horaInicio} lugar={sitio} fechaPorConfirmar={fechaPorConfirmar} />
    </div>

    <aside class="torneo__datos" aria-label="Datos del torneo">
      <dl>
        <div>
          <dt class="rotulo">Fecha</dt>
          <dd>
            <time datetime={isoDia(fecha)}>{diaSemana(fecha)}, {fechaLarga(fecha)}</time>
            {fechaPorConfirmar && <span class="confirmar">(confirmar)</span>}
          </dd>
        </div>
        <div>
          <dt class="rotulo">Hora</dt>
          <dd>{horaInicio} h</dd>
        </div>
        <div>
          <dt class="rotulo">Lugar</dt>
          <dd>
            {centro ? <a href={`/centros/${centro.id}/`}>{sitio}</a> : sitio}
            <span class="torneo__direccion">{direccion}</span>
          </dd>
        </div>
        {
          categorias.length > 0 && (
            <div>
              <dt class="rotulo">Categorías</dt>
              <dd class="torneo__categorias">{categorias.join(' · ')}</dd>
            </div>
          )
        }
      </dl>
      <div class="torneo__inscripcion">
        {
          plazoAbierto ? (
            <>
              {fechaLimite && (
                <p class="torneo__plazo">
                  <span class="etiqueta etiqueta--alerta">Inscripción hasta el {fechaLarga(fechaLimite).replace(/ de \d{4}$/, '')}</span>
                  {fechaPorConfirmar && <span class="confirmar">(confirmar)</span>}
                </p>
              )}
              <a
                href={inscripcion.tipo === 'formulario' ? '/#contacto' : inscripcion.url}
                class="boton torneo__boton"
                {...(inscripcion.tipo === 'externa' ? { target: '_blank', rel: 'noopener' } : {})}
              >
                Inscribirme
              </a>
            </>
          ) : (
            <p class="texto-suave">La inscripción está cerrada.</p>
          )
        }
        {
          bases && (
            <a href={bases.url} class="enlace-flecha torneo__bases">
              {bases.titulo}
            </a>
          )
        }
      </div>
    </aside>

    <div class="torneo__texto">
      <div class="prosa">
        <Content />
      </div>
      {
        estado === 'celebrado' && cronica && (
          <section>
            <h2 class="titulo-dorado">Crónica</h2>
            <p>{cronica}</p>
          </section>
        )
      }
    </div>
  </div>

  {
    estado !== 'celebrado' && (
      <section class="seccion seccion--crema despues">
        <div class="contenedor">
          <div class="seccion__cabecera">
            <div>
              <h2 class="titulo-dorado">Después del torneo</h2>
              <p class="seccion__intro">Cuando se celebre, en esta misma página aparecerán:</p>
            </div>
          </div>
          <ul class="despues__lista">
            {despues.map((d) => (
              <li>
                <IconoPieza pieza={d.pieza} tamano={34} class="despues__icono" />
                <h3>{d.titulo}</h3>
                <p class="texto-suave">{d.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .torneo__cabecera {
    padding-top: 40px;
    padding-bottom: 40px;
  }
  @media (min-width: 960px) {
    .torneo__cabecera {
      padding-top: 56px;
      padding-bottom: 48px;
    }
  }
  .migas {
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--color-text-soft);
  }
  .migas a {
    color: var(--color-text-soft);
  }
  .etiqueta {
    margin: 0 0 14px;
  }
  .torneo__cabecera h1 {
    max-width: 20ch;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    margin: 0;
  }

  /* Cartel y texto a la izquierda; datos clave en una columna fija a la derecha */
  .torneo__rejilla {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'cartel' 'datos' 'texto';
    padding-bottom: var(--separacion);
  }
  @media (min-width: 960px) {
    .torneo__rejilla {
      grid-template-columns: minmax(0, 1fr) 380px;
      grid-template-areas: 'cartel datos' 'texto datos';
      column-gap: 80px;
      row-gap: 56px;
      align-items: start;
    }
    .torneo__datos {
      position: sticky;
      top: 88px;
    }
  }
  .torneo__cartel {
    grid-area: cartel;
    max-width: 520px;
  }
  .torneo__datos {
    grid-area: datos;
    padding: 28px;
    border-radius: var(--radio-foto);
    background: var(--color-crema);
    border-top: 1px solid var(--color-gold);
  }
  .torneo__texto {
    grid-area: texto;
  }
  .torneo__datos dl {
    margin: 0;
  }
  .torneo__datos dl > div {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-borde);
  }
  .torneo__datos dl > div:first-child {
    padding-top: 0;
  }
  .torneo__datos .rotulo {
    margin-bottom: 4px;
  }
  .torneo__datos dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-primary);
  }
  .torneo__datos dd a {
    color: var(--color-primary);
  }
  .torneo__datos dd :global(time)::first-letter {
    text-transform: uppercase;
  }
  .torneo__direccion {
    display: block;
    font-weight: 400;
    font-size: 15px;
    color: var(--color-text-soft);
  }
  .torneo__categorias {
    font-weight: 500 !important;
    font-size: 15px;
  }
  .torneo__inscripcion {
    padding-top: 22px;
  }
  .torneo__plazo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
  }
  .torneo__boton {
    width: 100%;
  }
  .torneo__bases {
    margin-top: 18px;
  }

  .despues__lista {
    display: grid;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .despues__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .despues__lista {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .despues__lista li {
    padding-top: 20px;
    border-top: 1px solid var(--color-borde);
  }
  .despues :global(.despues__icono) {
    color: var(--color-gold);
    margin-bottom: 14px;
  }
  .despues__lista h3 {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .despues__lista p {
    margin: 0;
    font-size: 15px;
  }
</style>
