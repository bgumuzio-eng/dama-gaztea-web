---
import { ruta } from '../../lib/rutas';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CabeceraFoto from '../../components/CabeceraFoto.astro';
import Foto from '../../components/Foto.astro';
import CentroCard from '../../components/CentroCard.astro';
import Mapa from '../../components/Mapa.astro';
import TorneoCard from '../../components/TorneoCard.astro';
import ajustes from '../../data/ajustes.json';
import { centrosActivos, torneosProximos } from '../../lib/datos';
import { enlaceWhatsApp, TIPOS_CENTRO } from '../../lib/formato';

export async function getStaticPaths() {
  const centros = await centrosActivos();
  return centros.map((centro) => ({ params: { slug: centro.id }, props: { centro, todos: centros } }));
}

interface Props {
  centro: CollectionEntry<'centros'>;
  todos: CollectionEntry<'centros'>[];
}
const { centro, todos } = Astro.props;
const { nombre, localidad, tipo, direccion, ubicacion, descripcion, grupos, mostrarPlazas, fotos } = centro.data;
const otros = todos.filter((c) => c.id !== centro.id);
const torneos = (await torneosProximos()).filter((t) => t.data.lugar.centro?.id === centro.id);
const mensaje = `Hola, quiero información sobre las clases de ajedrez en ${nombre} (${localidad}).`;
const enlaceMapa = `https://www.google.com/maps/search/?api=1&query=${ubicacion.lat},${ubicacion.lng}`;
const [portada, ...galeria] = fotos;

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${ajustes.nombreAcademia}: ${nombre}`,
  description: descripcion,
  address: { '@type': 'PostalAddress', streetAddress: direccion, addressLocality: localidad, addressRegion: 'Bizkaia', addressCountry: 'ES' },
  geo: { '@type': 'GeoCoordinates', latitude: ubicacion.lat, longitude: ubicacion.lng },
  telephone: ajustes.telefono,
};

const textoPlazas = (n?: number) => (n === undefined ? '' : n === 0 ? 'Completo' : n === 1 ? '1 plaza libre' : `${n} plazas libres`);
// Los textos "(confirmar)" del contenido se resaltan en rojo
const partes = (t: string) => t.split(/(\(confirmar\)|\(dirección exacta por confirmar\))/);
---

<Base
  titulo={`Clases de ajedrez en ${localidad}: ${nombre}`}
  descripcion={`Clases de ajedrez en ${localidad}. ${descripcion}`}
  whatsappMensaje={mensaje}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

  <CabeceraFoto
    imagen={portada ?? { alt: nombre }}
    antetitulo={`${TIPOS_CENTRO[tipo]} · ${localidad}`}
    titulo={`Clases de ajedrez en ${localidad}`}
    migas={[{ texto: 'Inicio', href: '/' }, { texto: 'Centros y horarios', href: '/#centros' }, { texto: nombre }]}
  >
    <p class="cabecera-foto__sub">
      <strong class="centro__nombre">{nombre}</strong><br />
      {partes(direccion).map((p) => (p.includes('confirmar') ? <span class="confirmar-claro">{p}</span> : p))}
    </p>
  </CabeceraFoto>

  <div class="contenedor centro__rejilla seccion">
    <div class="centro__principal">
      <p class="centro__descripcion">{descripcion}</p>

      <section aria-labelledby="horarios-titulo">
        <h2 id="horarios-titulo" class="titulo-dorado">Grupos y horarios</h2>
        <p class="texto-suave pequeno">Curso 2026/2027</p>
        <ul class="grupos">
          {
            grupos.map((g) => (
              <li class="grupo">
                <div class="grupo__dia">
                  <span class="grupo__dia-nombre">{g.diaSemana}</span>
                  <span class="grupo__hora">
                    {g.horaInicio} a {g.horaFin}
                  </span>
                </div>
                <div class="grupo__info">
                  <span class="grupo__nivel">{g.nivel}</span>
                  <span class="grupo__edades">
                    Edades: {partes(g.edades).map((p) => (p.includes('confirmar') ? <span class="confirmar">{p}</span> : p))}
                  </span>
                </div>
                {(mostrarPlazas || g.plazasDisponibles === 0) && g.plazasDisponibles !== undefined && (
                  <span class:list={['grupo__plazas', { 'grupo__plazas--completo': g.plazasDisponibles === 0 }]}>
                    {textoPlazas(g.plazasDisponibles)}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      {
        galeria.length > 0 && (
          <section class="centro__galeria" aria-labelledby="fotos-titulo">
            <h2 id="fotos-titulo" class="titulo-dorado">
              Así son las clases
            </h2>
            <ul>
              {galeria.map((f) => (
                <li>
                  <Foto imagen={f} proporcion="4 / 3" ancho={900} class="centro__foto" />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        torneos.length > 0 && (
          <section class="centro__torneos">
            <h2 class="titulo-dorado">Próximos torneos aquí</h2>
            {torneos.map((t) => (
              <TorneoCard torneo={t} />
            ))}
          </section>
        )
      }
    </div>

    <aside class="centro__lateral">
      <div class="centro__contacto">
        <p class="etiqueta">¿Hay plaza?</p>
        <h2>Pregunta sin compromiso</h2>
        <p class="texto-suave">Te decimos qué grupo encaja con la edad y el nivel, y si queda sitio.</p>
        <a href={enlaceWhatsApp(mensaje)} class="boton centro__boton" target="_blank" rel="noopener">Escribir por WhatsApp</a>
        <a href={`tel:+34${ajustes.telefono.replace(/\s/g, '')}`} class="centro__telefono">o llama al {ajustes.telefono}</a>
      </div>
      <div class="centro__mapa">
        <Mapa centros={todos} destacado={centro.id} />
        <a href={enlaceMapa} class="enlace-flecha centro__como-llegar" target="_blank" rel="noopener">Cómo llegar en Google Maps</a>
      </div>
    </aside>
  </div>

  <section class="seccion seccion--crema">
    <div class="contenedor">
      <div class="seccion__cabecera">
        <h2 class="titulo-dorado">Otros centros</h2>
        <a href={ruta('/#centros')} class="enlace-flecha">Todos los horarios</a>
      </div>
      <ul class="otros">
        {
          otros.map((c) => (
            <li>
              <CentroCard centro={c} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .centro__nombre {
    font-family: var(--font-titulo);
    font-weight: var(--titulo-peso);
    font-size: 1.35rem;
    color: var(--color-white);
  }
  .confirmar-claro {
    color: #ffc2b8;
  }
  .centro__rejilla {
    display: grid;
    gap: 56px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 960px) {
    .centro__rejilla {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 80px;
      align-items: start;
    }
    .centro__lateral {
      position: sticky;
      top: 88px;
    }
  }
  .centro__descripcion {
    max-width: 60ch;
    margin-bottom: 56px;
    font-family: var(--font-titulo);
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
    line-height: 1.4;
    color: var(--color-primary);
  }
  .centro__principal h2 {
    margin-bottom: 8px;
  }

  .grupos {
    list-style: none;
    margin: 24px 0 64px;
    padding: 0;
    border-top: 1px solid var(--color-borde);
  }
  .grupo {
    display: grid;
    gap: 6px 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-borde);
  }
  @media (min-width: 640px) {
    .grupo {
      grid-template-columns: 200px 1fr auto;
      align-items: baseline;
    }
  }
  .grupo__dia {
    display: flex;
    flex-direction: column;
  }
  .grupo__dia-nombre {
    font-family: var(--font-titulo);
    font-weight: var(--titulo-peso);
    font-size: 1.35rem;
    color: var(--color-primary);
  }
  .grupo__hora {
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-soft);
  }
  .grupo__info {
    display: flex;
    flex-direction: column;
  }
  .grupo__nivel {
    font-weight: 600;
  }
  .grupo__edades {
    font-size: 15px;
    color: var(--color-text-soft);
  }
  .grupo__plazas {
    justify-self: start;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .grupo__plazas--completo {
    color: var(--color-text-soft);
  }

  .centro__galeria {
    margin-bottom: 64px;
  }
  .centro__galeria ul {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .centro__galeria :global(.centro__foto) {
    border-radius: var(--radio-foto);
  }

  .centro__contacto {
    padding: 28px;
    margin-bottom: 20px;
    border-radius: var(--radio-foto);
    background: var(--color-crema);
    border-top: 1px solid var(--color-gold);
  }
  .centro__contacto .etiqueta {
    margin: 0 0 8px;
  }
  .centro__contacto h2 {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }
  .centro__boton {
    width: 100%;
    margin-top: 8px;
  }
  .centro__telefono {
    display: block;
    margin-top: 14px;
    text-align: center;
    font-size: 15px;
    color: var(--color-primary);
  }
  .centro__como-llegar {
    margin-top: 14px;
  }

  .otros {
    display: grid;
    gap: 40px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 760px) {
    .otros {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
